---
/**
 * <Card> — content card. Auto-adjusts for section-dark context.
 * Slot expects h3 + p + optional list + optional badges.
 */
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---
<div class:list={['card', className]}>
  <slot />
</div>

<style>
  .card {
    padding: var(--space-md);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .card :global(h3) {
    font-size: var(--text-h3-size);
    line-height: var(--text-h3-line);
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
  }

  .card :global(p) {
    color: var(--text-secondary);
    font-size: var(--text-small-size);
    line-height: 1.6;
    margin: 0;
  }

  .card :global(ul) {
    margin-block-start: var(--space-xs);
    padding-inline-start: 1.25rem;
    color: var(--text-secondary);
    font-size: var(--text-small-size);
  }

  .card :global(li + li) {
    margin-block-start: 0.25rem;
  }

  /* Dark section context */
  :global(.section-dark) .card {
    background: rgba(255, 255, 255, 0.05);
    border-color: var(--color-dark-border);
  }

  :global(.section-dark) .card :global(h3) {
    color: #ffffff;
  }

  :global(.section-dark) .card :global(p),
  :global(.section-dark) .card :global(ul) {
    color: var(--text-on-dark-muted);
  }
</style>
