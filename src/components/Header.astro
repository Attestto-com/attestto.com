---
/**
 * <Header> — sticky dark navigation. Ports the OLD site's nav pattern:
 * dark navy background, subtle transparency + blur, white brand, muted links.
 */
import DigitalIdCta from './DigitalIdCta.astro';
import { primaryNav } from '../config/site';

interface Props {
  lang?: 'en' | 'es';
}

const { lang = 'en' } = Astro.props;

const nav = primaryNav(lang);
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Attestto (home)">
      <img src="/logo-full-white.svg" alt="" width="120" height="28" />
    </a>

    <nav class="primary-nav" aria-label="Primary">
      <ul>
        {nav.map((item) => {
          const isActive = current === item.href;
          return (
            <li>
              <a href={item.href} aria-current={isActive ? 'page' : undefined} class:list={[{ active: isActive }]}>
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="header-actions">
      <DigitalIdCta lang={lang} variant="header" />
      <button class="menu-toggle" aria-label="Toggle menu" aria-expanded="false" data-menu-toggle>
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <nav class="mobile-nav" aria-label="Primary mobile" data-mobile-nav>
    <div class="container">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
        <li class="mobile-cta"><DigitalIdCta lang={lang} variant="mobile" /></li>
      </ul>
    </div>
  </nav>
</header>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.querySelector('[data-menu-toggle]');
    const nav = document.querySelector('[data-mobile-nav]');
    if (!btn || !nav) return;
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      nav.classList.toggle('open', !open);
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    background: rgba(15, 23, 42, 0.97);
    backdrop-filter: saturate(150%) blur(8px);
    border-bottom: 1px solid var(--color-dark-border);
    z-index: 100;
    padding-block: var(--space-sm);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    flex-shrink: 0;
  }

  .brand img {
    height: 1.75rem;
    width: auto;
  }

  .primary-nav {
    display: none;
    flex: 1;
    justify-content: center;
  }

  .primary-nav ul {
    display: flex;
    list-style: none;
    padding: 0;
    margin: 0;
    gap: var(--space-md);
  }

  .primary-nav a {
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    transition: color 0.15s;
  }

  .primary-nav a:hover,
  .primary-nav a.active {
    color: #ffffff;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
  }

  .cta-button {
    display: none;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 1rem;
    background: #ffffff;
    color: var(--color-ink);
    border-radius: var(--radius-md);
    font-family: var(--font-sans);
    font-size: var(--text-small-size);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.15s;
  }

  .cta-button:hover {
    background: var(--color-border);
    text-decoration: none;
  }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-dark-border);
    background: transparent;
    color: #ffffff;
    border-radius: var(--radius-md);
    cursor: pointer;
  }

  .mobile-nav {
    display: none;
    border-block-start: 1px solid var(--color-dark-border);
    padding-block: var(--space-sm);
    background: rgba(15, 23, 42, 0.97);
  }

  .mobile-nav.open {
    display: block;
  }

  .mobile-nav ul {
    display: flex;
    flex-direction: column;
    list-style: none;
    padding: 0;
    margin: 0;
    gap: var(--space-2);
  }

  .mobile-nav a {
    display: block;
    padding: var(--space-2) 0;
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    font-weight: 500;
  }

  .mobile-cta a {
    display: inline-block;
    padding: 0.625rem 1rem;
    background: #ffffff;
    color: var(--color-ink);
    border-radius: var(--radius-md);
    margin-block-start: var(--space-2);
    font-weight: 600;
  }

  @media (min-width: 768px) {
    .primary-nav { display: flex; }
    .cta-button { display: inline-flex; }
    .menu-toggle { display: none; }
  }
</style>
