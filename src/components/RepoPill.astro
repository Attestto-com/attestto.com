---
/**
 * <RepoPill> — small pill link to a repo, spec URL, or external reference.
 * Sits at the bottom of a Card. Works in both light and dark section contexts.
 *
 * type:
 *   - github: GitHub repo
 *   - spec:   published specification (spec.attestto.com/*)
 *   - live:   live deployment URL
 *   - ext:    external reference (standards body, docs, etc.)
 */
interface Props {
  href: string;
  label: string;
  type?: 'github' | 'spec' | 'live' | 'ext';
}

const { href, label, type = 'github' } = Astro.props;
---
<a class:list={['repo-pill', `type-${type}`]} href={href} rel="noopener" target="_blank">
  {type === 'github' && (
    <svg class="pill-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
      <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2 .37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
    </svg>
  )}
  {type === 'spec' && (
    <svg class="pill-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M3 2h7l3 3v9H3V2z" stroke-linejoin="round" />
      <path d="M10 2v3h3M5 8h6M5 11h6" stroke-linecap="round" />
    </svg>
  )}
  {type === 'live' && (
    <svg class="pill-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <circle cx="8" cy="8" r="6" />
      <path d="M2 8h12M8 2c1.5 2 2.5 4 2.5 6s-1 4-2.5 6c-1.5-2-2.5-4-2.5-6s1-4 2.5-6z" />
    </svg>
  )}
  {type === 'ext' && (
    <svg class="pill-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M9 3h4v4M13 3L7 9M11 8v5H3V5h5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )}
  <span class="pill-label">{label}</span>
</a>

<style>
  .repo-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.3rem 0.65rem;
    border-radius: var(--radius-pill);
    background: var(--color-slate-100);
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-decoration: none;
    line-height: 1;
    margin-block-start: auto;
    align-self: flex-start;
    border: 1px solid var(--color-border);
    transition: background 0.15s, border-color 0.15s;
  }

  .repo-pill:hover {
    background: #ffffff;
    border-color: var(--color-border-strong);
    text-decoration: none;
  }

  .pill-icon {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
  }

  .pill-label {
    letter-spacing: 0.01em;
  }

  /* Dark section context */
  :global(.section-dark) .repo-pill {
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.85);
    border-color: var(--color-dark-border);
  }

  :global(.section-dark) .repo-pill:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.2);
    color: #ffffff;
  }
</style>
