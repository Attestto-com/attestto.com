---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/inter/800.css';
import '@fontsource/ibm-plex-serif/400.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/600.css';

import '../styles/tokens.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

interface Crumb {
  name: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  lang?: 'en' | 'es';
  darkHero?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Explicit breadcrumb trail. When omitted, one is derived from the URL. */
  breadcrumbs?: Crumb[];
}

const {
  title,
  description,
  canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://attestto.com').href,
  ogImage = '/og-image.png',
  lang = 'en',
  darkHero = false,
  jsonLd,
  breadcrumbs,
} = Astro.props;

// Breadcrumbs: use the provided trail, or derive one from the URL path. The
// home page (no path segments) gets none.
const SEG_LABELS: Record<string, string> = {
  products: 'Products',
  productos: 'Productos',
  blog: 'Blog',
};
const pathSegments = new URL(canonical).pathname.split('/').filter(Boolean);
const derivedCrumbs: Crumb[] =
  pathSegments.length === 0
    ? []
    : [
        { name: lang === 'es' ? 'Inicio' : 'Home', href: '/' },
        ...pathSegments.map((seg, i) => ({
          name: i === pathSegments.length - 1 ? title : (SEG_LABELS[seg] ?? seg),
          href: '/' + pathSegments.slice(0, i + 1).join('/') + '/',
        })),
      ];
const resolvedCrumbs = breadcrumbs ?? derivedCrumbs;

const siteName = 'Attestto';
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
const ogImageUrl = new URL(ogImage, Astro.site ?? 'https://attestto.com').href;

const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteName,
  url: 'https://attestto.com',
  logo: 'https://attestto.com/logo.svg',
  description: 'Digital identity infrastructure built on open standards. W3C, NIST, ISO, IETF.',
  foundingLocation: {
    '@type': 'Place',
    addressCountry: 'CR',
  },
  sameAs: [
    'https://attestto.org',
    'https://github.com/Attestto-com',
  ],
};

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  url: 'https://attestto.com',
  description: 'Digital identity infrastructure built on open standards.',
  publisher: {
    '@type': 'Organization',
    name: siteName,
    url: 'https://attestto.com',
  },
};

const jsonLdBlocks = [organizationLd, websiteLd, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0f172a" />
  <meta name="generator" content={Astro.generator} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate icon" href="/favicon.jpg" />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="en" href={canonical} />
  <link rel="alternate" hreflang="es" href={canonical} />
  <link rel="alternate" hreflang="x-default" href={canonical} />

  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:locale" content={lang === 'es' ? 'es_CR' : 'en_US'} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={fullTitle} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />

  <meta name="robots" content="index, follow" />

  {jsonLdBlocks.map((block) => (
    <script type="application/ld+json" set:html={JSON.stringify(block)} />
  ))}
</head>
<body class:list={[{ 'dark-hero': darkHero }]}>
  <a href="#main" class="skip-link">Skip to main content</a>
  <Header lang={lang} />
  {resolvedCrumbs.length > 1 && <Breadcrumbs items={resolvedCrumbs} />}
  <main id="main">
    <slot />
  </main>
  <Footer lang={lang} />
</body>
</html>
