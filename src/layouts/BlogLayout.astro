---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { data } = post;

const readingTime = (() => {
  const words = post.body.split(/\s+/).length;
  return Math.max(1, Math.round(words / 220));
})();

const canonicalHref = data.canonicalUrl ?? new URL(Astro.url.pathname, Astro.site ?? 'https://attestto.com').href;

const wordCount = post.body.split(/\s+/).filter(Boolean).length;

const blogPostingLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.description,
  author: {
    '@type': 'Organization',
    name: data.author,
    url: 'https://attestto.com',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Attestto',
    logo: {
      '@type': 'ImageObject',
      url: 'https://attestto.com/logo.svg',
    },
  },
  datePublished: data.publishDate.toISOString(),
  dateModified: data.publishDate.toISOString(),
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalHref,
  },
  keywords: data.tags.join(', '),
  wordCount,
  inLanguage: data.lang === 'es' ? 'es-CR' : 'en-US',
  isAccessibleForFree: true,
  articleSection: data.tags[0] ?? 'Standards',
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://attestto.com/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://attestto.com/blog/' },
    { '@type': 'ListItem', position: 3, name: data.title },
  ],
};

const fmtDate = new Intl.DateTimeFormat(data.lang === 'es' ? 'es-CR' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<BaseLayout
  title={data.title}
  description={data.description}
  canonical={data.canonicalUrl}
  lang={data.lang}
  jsonLd={[blogPostingLd, breadcrumbLd]}
>
  <article class="blog-article">
    <div class="container">
      <header class="article-header">
        <a href="/blog" class="back-link">← Blog</a>
        <div class="article-meta">
          {data.tags.length > 0 && (
            <ul class="tags" aria-label="Tags">
              {data.tags.slice(0, 3).map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          )}
        </div>
        <h1>{data.title}</h1>
        <p class="article-summary">{data.description}</p>
        <div class="byline small muted">
          <span>{data.author}</span>
          <span aria-hidden="true">·</span>
          <time datetime={data.publishDate.toISOString()}>{fmtDate.format(data.publishDate)}</time>
          <span aria-hidden="true">·</span>
          <span>{readingTime} min read</span>
        </div>
      </header>

      <div class="article-body body-serif">
        <slot />
      </div>

      <footer class="article-footer">
        <a href="/blog" class="back-link">← All posts</a>
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  .blog-article {
    padding-block: var(--space-xl) var(--space-xl);
  }

  @media (min-width: 1024px) {
    .blog-article {
      padding-block: 6rem 8rem;
    }
  }

  .article-header {
    max-width: 680px;
    margin: 0 auto var(--space-12);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .back-link {
    align-self: flex-start;
    color: var(--text-muted);
    text-decoration: none;
    font-size: var(--text-small-size);
    font-family: var(--font-mono);
  }

  .back-link:hover {
    color: var(--text-primary);
  }

  .article-header h1 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 2.5rem;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .article-summary {
    font-size: var(--text-h4-size);
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .byline {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .tags {
    display: flex;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
  }

  .tags li {
    font-family: var(--font-mono);
    font-size: var(--text-small-size);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    padding: 2px 8px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
  }

  .article-body {
    max-width: 680px;
    margin-inline: auto;
  }

  .article-body :global(h2) {
    margin-block: var(--space-10) var(--space-4);
  }

  .article-body :global(h3) {
    margin-block: var(--space-8) var(--space-3);
  }

  .article-body :global(p) {
    color: var(--text-primary);
    margin-block: var(--space-4);
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    color: var(--text-primary);
    margin-block: var(--space-4);
    padding-inline-start: var(--space-6);
  }

  .article-body :global(li) {
    margin-block: var(--space-2);
  }

  .article-body :global(pre) {
    margin-block: var(--space-6);
  }

  .article-body :global(blockquote) {
    margin-block: var(--space-6);
    padding-inline-start: var(--space-4);
    border-inline-start: 3px solid var(--border-strong);
    color: var(--text-secondary);
    font-style: italic;
  }

  /* Tables — break out of the 720px article width on wider screens */
  .article-body :global(table) {
    width: 100%;
    margin-block: var(--space-8);
    border-collapse: collapse;
    font-family: var(--font-sans);
    font-size: var(--text-small-size);
    line-height: 1.5;
  }

  .article-body :global(table th),
  .article-body :global(table td) {
    padding: var(--space-3) var(--space-4);
    text-align: left;
    vertical-align: top;
    border-block-end: 1px solid var(--border-subtle);
    color: var(--text-primary);
  }

  .article-body :global(table th) {
    font-weight: 600;
    background: var(--surface-inset);
    color: var(--text-primary);
    border-block-end: 2px solid var(--border-strong);
    white-space: nowrap;
  }

  .article-body :global(table tbody tr:last-child td) {
    border-block-end: none;
  }

  .article-body :global(table code) {
    font-size: 0.9em;
  }

  /* On wide screens, tables break out of the 720px reading measure so their
     cells have room to breathe. Text stays at 720px for readability; tables
     extend up to the container width (1120px). */
  @media (min-width: 1024px) {
    .article-body :global(table) {
      margin-inline: -80px;
      width: calc(100% + 160px);
    }
  }

  @media (min-width: 1200px) {
    .article-body :global(table) {
      margin-inline: -160px;
      width: calc(100% + 320px);
    }
  }

  /* On mobile, restructure tables as stacked cards instead of the table grid.
     Assumes the first column is a category/label and subsequent columns are
     the values being compared. Works cleanly for 2-column (label + value) and
     3-column (label + low/weak + high/strong comparison) tables — the common
     shapes in our blog posts. Wider/differently-shaped tables need a custom
     Astro component and would ignore this rule via their own class. */
  @media (max-width: 640px) {
    .article-body :global(table),
    .article-body :global(table tbody),
    .article-body :global(table tr),
    .article-body :global(table td) {
      display: block;
      width: 100%;
    }

    .article-body :global(table) {
      margin-inline: 0;
      border-collapse: separate;
    }

    /* Hide the header row visually. Screen readers still get column context
       from the underlying HTML structure. */
    .article-body :global(table thead) {
      position: absolute;
      inset-inline-start: -9999px;
    }

    .article-body :global(table tr) {
      padding: var(--space-5);
      margin-block-end: var(--space-3);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      background: var(--surface-card);
    }

    .article-body :global(table tr:last-child) {
      margin-block-end: 0;
    }

    .article-body :global(table td) {
      padding: 0;
      border: none;
      line-height: 1.5;
    }

    /* First column = the category/axis heading */
    .article-body :global(table td:first-child) {
      font-size: var(--text-h4-size);
      font-weight: 600;
      color: var(--text-primary);
      margin-block-end: var(--space-3);
      padding-block-end: var(--space-3);
      border-block-end: 1px solid var(--border-subtle);
    }

    /* Non-first columns each get a mono-uppercase label prefix */
    .article-body :global(table td:not(:first-child)) {
      padding-block-start: var(--space-3);
      font-size: var(--text-small-size);
    }

    .article-body :global(table td:nth-child(2))::before,
    .article-body :global(table td:nth-child(3))::before {
      display: block;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--text-muted);
      margin-block-end: 4px;
    }

    .article-body :global(table td:nth-child(2))::before {
      content: "Low end";
    }

    .article-body :global(table td:nth-child(3))::before {
      content: "High end";
    }
  }

  .article-footer {
    max-width: 680px;
    margin: var(--space-16) auto 0;
    padding-block-start: var(--space-8);
    border-block-start: 1px solid var(--border-subtle);
  }

  @media (max-width: 640px) {
    .article-header h1 {
      font-size: 1.75rem;
    }
    .article-summary {
      font-size: var(--text-body-size);
    }
  }
</style>
